rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 排行榜紀錄：任何人可讀（公開展示），只有 Cloud Functions admin SDK 可寫
    match /scores/{scoreId} {
      allow read: if true;
      allow write: if false;
    }

    // 老師管理員白名單：只有本人可讀自己 doc（未來給後台檢查身分用）
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;  // 手動由 Firebase console 加管理員 uid
    }

    // 每日快照（dailySnapshot Cloud Function 寫入）：公開讀
    match /dailySnapshots/{date} {
      allow read: if true;
      allow write: if false;
    }
  }
}
