{
  "name": "maze-3d-game",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "3D 迷宮冒險 — React + Three.js 第一人稱迷宮探索遊戲（阿凱老師 / 石門國小）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "og": "node scripts/build-og.mjs",
    "icons": "node scripts/build-icons.mjs",
    "assets": "npm run og && npm run icons",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
